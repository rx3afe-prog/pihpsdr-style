+    return;
+  }
+  if (zmh_tb != tb) {
+    zmh_tb = tb;
+    zmh_mb = NULL;
+    zmh_hb = NULL;
+  }
+  if (!zmh_mb) {
+    zmh_mb = gtk_button_new_with_label("МЕНЮ");
+    gtk_widget_set_name(zmh_mb, "zmh-btn");
