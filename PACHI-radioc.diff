+/* ZMHTIMER: pervye 5 sekund posle starta podnimaem knopki povtorno */
+static gboolean zmh_startup_raise(gpointer data) {
+  static int n = 0;
+  (void)data;
+  zmh_raise();
+  n++;
+  if (n >= 50) { n = 0; return G_SOURCE_REMOVE; }
+  return G_SOURCE_CONTINUE;
+}
