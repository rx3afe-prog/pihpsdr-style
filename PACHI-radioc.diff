+void zen_agc_slider_sync(int id) {
+  if (!zen_agc_scale || !GTK_IS_WIDGET(zen_agc_scale)) return;
+  if (!receiver[id]) return;
+  double v = (receiver[id]->agc_gain + 20.0) / 1.4;
+  if (v < 0.0) v = 0.0;
+  if (v > 100.0) v = 100.0;
